<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Iniciar Sesion | SeguiPractica 2025</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body class="auth-body">

<div class="auth-screen">
  <div class="auth-left">
    <div class="auth-brand">
      <div class="brand-icon">&#x1F393;</div>
      <span class="brand-name">SeguiPractica</span>
    </div>
    <h1 class="auth-headline">Seguimiento de<br><span>Practicas Empresariales</span></h1>
    <p class="auth-sub">Plataforma institucional para la gestion y control de practicas. Periodo 2025-1.</p>
    <ul class="auth-features">
      <li>&#x1F4DD; Registro completo del formulario de practica</li>
      <li>&#x1F4CE; Carga de documentos: EPS, ARL, Contrato</li>
      <li>&#x1F4CB; Seguimientos 1 y 2 con notas y observaciones</li>
      <li>&#x1F4CA; Dashboard en tiempo real</li>
    </ul>
  </div>

  <div class="auth-right">
    <div class="auth-card">
      <h2 class="card-title">Bienvenido</h2>
      <p class="card-sub">Ingresa con tus credenciales institucionales</p>

      <% if (error_msg.length > 0) { %>
        <div class="alert alert-error"><%= error_msg[0] %></div>
      <% } %>
      <% if (success_msg.length > 0) { %>
        <div class="alert alert-success"><%= success_msg[0] %></div>
      <% } %>

      <form action="/login" method="POST">
        <div class="form-group">
          <label for="cedula">Cedula / Usuario</label>
          <input type="text" id="cedula" name="cedula" class="form-control"
                 placeholder="Numero de documento" required autocomplete="username">
        </div>
        <div class="form-group">
          <label for="password">Contrasena</label>
          <input type="password" id="password" name="password" class="form-control"
                 placeholder="Contrasena" required autocomplete="current-password">
        </div>
        <button type="submit" class="btn btn-primary btn-full">Ingresar al sistema</button>
      </form>

      <!-- SEPARADOR -->
      <div style="display:flex;align-items:center;gap:10px;margin:16px 0">
        <div style="flex:1;height:1px;background:#e2e8f0"></div>
        <span style="font-size:12px;color:#94a3b8;white-space:nowrap">o continua con</span>
        <div style="flex:1;height:1px;background:#e2e8f0"></div>
      </div>

      <!-- BOTON GOOGLE -->
      <a href="/auth/google"
         style="display:flex;align-items:center;justify-content:center;gap:10px;
                padding:11px 20px;border:1.5px solid #e2e8f0;border-radius:10px;
                background:#fff;color:#1e293b;font-size:14px;font-weight:600;
                text-decoration:none;margin-bottom:16px;transition:all .2s;
                box-shadow:0 1px 3px rgba(0,0,0,.06)"
         onmouseover="this.style.borderColor='#2563eb';this.style.background='#f8fafc'"
         onmouseout="this.style.borderColor='#e2e8f0';this.style.background='#fff'">
        <svg width="18" height="18" viewBox="0 0 48 48">
          <path fill="#FFC107" d="M43.6 20H24v8h11.3C33.6 32.6 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3 0 5.8 1.1 7.9 3l5.7-5.7C34.1 6.5 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20c11 0 19.7-8 19.7-20 0-1.3-.1-2.7-.1-4z"/>
          <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.5 16 19 13 24 13c3 0 5.8 1.1 7.9 3l5.7-5.7C34.1 6.5 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
          <path fill="#4CAF50" d="M24 44c5.2 0 9.9-1.9 13.5-5l-6.2-5.2C29.4 35.6 26.8 36 24 36c-5.2 0-9.6-3.3-11.3-8H6.3C9.6 37.5 16.3 44 24 44z"/>
          <path fill="#1976D2" d="M43.6 20H24v8h11.3c-.9 2.4-2.5 4.4-4.6 5.8l6.2 5.2C40.8 35.7 44 30.3 44 24c0-1.3-.1-2.7-.4-4z"/>
        </svg>
        Iniciar sesion con Google
      </a>

      <div class="auth-divider">
        <a href="/verificar" class="link-register">
          ¿Estudiante nuevo? Crea tu cuenta aqui
        </a>
      </div>

      <div class="demo-box">
        <p class="demo-title">Credenciales de prueba</p>
        <div class="demo-creds">
          <span>Admin: <code>admin / admin123</code></span>
          <span>Docente: <code>DOC001 / docente123</code></span>
        </div>
      </div>
    </div>
  </div>
</div>

</body>
</html>