<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Acceso no permitido | SeguiPractica</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body class="auth-body">
<div class="auth-screen">
  <div style="background:#fff;border-radius:20px;padding:48px 40px;max-width:460px;width:100%;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.15)">
    <div style="font-size:52px;margin-bottom:16px">🚫</div>
    <h2 style="font-size:22px;font-weight:700;color:#0b1426;margin-bottom:10px">Acceso no permitido</h2>
    <p style="font-size:14px;color:#64748b;margin-bottom:24px;line-height:1.6">
      <%= mensaje %>
    </p>
    <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:14px;font-size:13px;color:#b91c1c;margin-bottom:24px">
      Solo los estudiantes, docentes y administradores registrados en SeguiPractica pueden acceder al sistema.
    </div>
    <a href="/login" style="display:block;background:#2563eb;color:#fff;padding:12px;border-radius:10px;font-weight:600;text-decoration:none;font-size:14px">
      Ir al inicio de sesion
    </a>
  </div>
</div>
</body>
</html>