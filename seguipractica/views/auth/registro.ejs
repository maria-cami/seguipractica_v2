<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registro de Estudiante | SeguiPractica 2025</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body class="auth-body">

<div class="auth-screen">
  <div class="auth-left">
    <div class="auth-brand">
      <div class="brand-icon">&#x1F393;</div>
      <span class="brand-name">SeguiPractica</span>
    </div>
    <h1 class="auth-headline">Registro de<br><span>Estudiante</span></h1>
    <p class="auth-sub">Completa todos los datos de tu practica empresarial. El proceso tiene 4 pasos.</p>
    <ul class="auth-features">
      <li>&#x2139; Paso 1: Datos personales y acceso</li>
      <li>&#x1F3E2; Paso 2: Datos de la empresa</li>
      <li>&#x1F4C4; Paso 3: Contrato y funciones</li>
      <li>&#x1F3E5; Paso 4: Seguridad social</li>
    </ul>
    <div style="margin-top:auto;padding-top:32px">
      <a href="/login" class="link-back">&#x2190; Volver al inicio de sesion</a>
    </div>
  </div>

  <div class="auth-right" style="align-items:flex-start;padding-top:30px">
    <div class="auth-card" style="max-width:640px;width:100%">

      <% if (error_msg.length > 0) { %>
        <div class="alert alert-error"><%= error_msg[0] %></div>
      <% } %>

      <div class="steps-bar" id="steps-bar">
        <div class="step active" data-step="1">
          <div class="step-num">1</div>
          <div class="step-lbl">Cuenta</div>
        </div>
        <div class="step-line"></div>
        <div class="step" data-step="2">
          <div class="step-num">2</div>
          <div class="step-lbl">Empresa</div>
        </div>
        <div class="step-line"></div>
        <div class="step" data-step="3">
          <div class="step-num">3</div>
          <div class="step-lbl">Contrato</div>
        </div>
        <div class="step-line"></div>
        <div class="step" data-step="4">
          <div class="step-num">4</div>
          <div class="step-lbl">Seguridad Social</div>
        </div>
      </div>

      <form action="/registro" method="POST" enctype="multipart/form-data" id="reg-form">

        <!-- ===== PASO 1 ===== -->

        <div class="form-step active" id="step-1">
          <h3 class="step-title">Datos personales y acceso</h3>

          <div class="form-row">
            <div class="form-group">
              <label>Nombres *</label>
              <input type="text" name="nombres" class="form-control" placeholder="Nombres" required>
            </div>
            <div class="form-group">
              <label>Apellidos *</label>
              <input type="text" name="apellidos" class="form-control" placeholder="Apellidos" required>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Cedula *</label>
              <input type="text" name="cedula" class="form-control" id="inp-cedula" placeholder="1023626875" required>
            </div>
            <div class="form-group">
              <label>Correo Electronico *</label>
              <input type="email" name="email" class="form-control" placeholder="correo@est.edu.co" required>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Celular *</label>
              <input type="tel" name="celular" class="form-control" placeholder="+57 300 000 0000" required>
            </div>
            <div class="form-group">
              <label>Telefono</label>
              <input type="tel" name="telefono" class="form-control" placeholder="(604) 000-0000">
            </div>
          </div>

          <!-- ESTRUCTURA UNIVERSITARIA -->
          <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;padding:14px 16px;margin-bottom:14px">
            <div style="font-size:12px;font-weight:700;color:#1e40af;margin-bottom:10px;text-transform:uppercase;letter-spacing:.5px">
              🏛️ Facultad · Programa · Semestre de Practica
            </div>

            <div class="form-row">
              <div class="form-group">
                <label>Facultad *</label>
                <select name="facultad_id" class="form-control" id="sel-facultad"
                        onchange="filtrarProgramas(this.value)" required>
                  <option value="">-- Selecciona facultad --</option>
                  <% for (var fi = 0; fi < facultades.length; fi++) { %>
                    <option value="<%= facultades[fi].id %>"><%= facultades[fi].nombre %></option>
                  <% } %>
                </select>
              </div>
              <div class="form-group">
                <label>Programa *</label>
                <select name="programa_id" class="form-control" id="sel-programa"
                        onchange="filtrarSemestres(this.value)" required>
                  <option value="">-- Selecciona programa --</option>
                  <% for (var pi2 = 0; pi2 < programas.length; pi2++) { %>
                    <option value="<%= programas[pi2].id %>"
                            data-facultad="<%= programas[pi2].facultad_id %>">
                      <%= programas[pi2].nombre %>
                    </option>
                  <% } %>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label>Semestre de Practica *</label>
              <select name="semestre_practica" class="form-control" id="sel-semestre" required>
                <option value="">-- Primero selecciona la facultad y programa --</option>
                <% for (var si2 = 0; si2 < semestres.length; si2++) { %>
                  <option value="<%= semestres[si2].nombre %>"
                          data-programa="<%= semestres[si2].programa_id %>">
                    <%= semestres[si2].nombre %> — <%= semestres[si2].descripcion %>
                  </option>
                <% } %>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Docente Asignado</label>
              <select name="docente_id" class="form-control">
                <option value="">Sin asignar</option>
                <% for (var di2 = 0; di2 < docentes.length; di2++) { %>
                  <option value="<%= docentes[di2].id %>">
                    <%= docentes[di2].nombres %> <%= docentes[di2].apellidos %>
                  </option>
                <% } %>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Contrasena *</label>
              <input type="password" name="password" class="form-control" id="pass1" placeholder="Minimo 6 caracteres" required>
            </div>
            <div class="form-group">
              <label>Confirmar Contrasena *</label>
              <input type="password" name="password2" class="form-control" id="pass2" placeholder="Repetir contrasena" required>
            </div>
          </div>
        </div>

        <!-- ===== PASO 2 ===== -->
        <div class="form-step" id="step-2">
          <h3 class="step-title">Datos de la empresa</h3>

          <div class="form-row">
            <div class="form-group">
              <label>NIT de la Empresa *</label>
              <input type="text" name="empresa_nit" class="form-control" placeholder="890.903.938-8">
            </div>
            <div class="form-group">
              <label>Nombre de la Empresa *</label>
              <input type="text" name="empresa_nombre" class="form-control" placeholder="Razon social">
            </div>
          </div>

          <div class="form-group">
            <label>Direccion</label>
            <input type="text" name="empresa_dir" class="form-control" placeholder="Cl 50 #51-66">
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Telefono de la Empresa</label>
              <input type="tel" name="empresa_tel" class="form-control" placeholder="(604) 000-0000">
            </div>
            <div class="form-group">
              <label>Barrio</label>
              <input type="text" name="empresa_barrio" class="form-control" placeholder="Barrio">
            </div>
          </div>

          <div class="form-group">
            <label>Punto de Referencia</label>
            <input type="text" name="empresa_pref" class="form-control" placeholder="Cerca de...">
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Clasificacion de la Empresa</label>
              <select name="empresa_clasif" class="form-control">
                <option>Grande</option>
                <option>Mediana</option>
                <option>Pequena</option>
                <option>Microempresa</option>
              </select>
            </div>
            <div class="form-group">
              <label>Naturaleza de la Empresa</label>
              <select name="empresa_naturaleza" class="form-control">
                <option>Privada</option>
                <option>Publica</option>
                <option>Mixta</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label>Sector Empresarial</label>
            <select name="empresa_sector" class="form-control">
              <option>Financiero</option>
              <option>Tecnologia</option>
              <option>Salud</option>
              <option>Educacion</option>
              <option>Alimentos</option>
              <option>Industrial</option>
              <option>Comercio</option>
              <option>Servicios</option>
              <option>Construccion</option>
              <option>Juegos y Apuestas</option>
              <option>Otro</option>
            </select>
          </div>

          <h4 class="subsection-title">Jefe / Supervisor directo</h4>

          <div class="form-row">
            <div class="form-group">
              <label>Nombre Completo</label>
              <input type="text" name="jefe_nombre" class="form-control" placeholder="Nombre del supervisor">
            </div>
            <div class="form-group">
              <label>Correo Electronico</label>
              <input type="email" name="jefe_email" class="form-control" placeholder="jefe@empresa.com">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Telefono</label>
              <input type="tel" name="jefe_telefono" class="form-control">
            </div>
            <div class="form-group">
              <label>Celular</label>
              <input type="tel" name="jefe_celular" class="form-control">
            </div>
          </div>
        </div>

        <!-- ===== PASO 3 ===== -->
        <div class="form-step" id="step-3">
          <h3 class="step-title">Contrato y funciones</h3>

          <div class="form-row">
            <div class="form-group">
              <label>Cargo</label>
              <input type="text" name="cargo" class="form-control" placeholder="Ej: Analista Jr.">
            </div>
            <div class="form-group">
              <label>Tipo de Contrato</label>
              <select name="tipo_contrato" class="form-control">
                <option>Practica laboral</option>
                <option>Contrato laboral</option>
                <option>Pasantia</option>
                <option>Practica investigativa</option>
                <option>Practica de emprendimiento</option>
                <option>Voluntariado</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label>Contrato Laboral / Carta Laboral</label>
            <input type="text" name="carta_laboral" class="form-control"
                   placeholder="N. de contrato o referencia" style="margin-bottom:8px">
            <div style="border:2px dashed #cbd5e1;border-radius:10px;padding:16px;text-align:center;background:#f8fafc;cursor:pointer;position:relative">
              <input type="file" name="archivo_contrato" accept=".pdf,.jpg,.jpeg,.png"
                     style="position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%"
                     onchange="mostrarArchivo(this,'contrato')">
              <div id="contrato-placeholder">
                <div style="font-size:24px;margin-bottom:6px">📄</div>
                <div style="font-size:13px;font-weight:600;color:#475569">Haz clic para subir el contrato</div>
                <div style="font-size:11px;color:#94a3b8;margin-top:3px">PDF, JPG o PNG — max. 5 MB</div>
              </div>
              <div id="contrato-preview" style="display:none;align-items:center;gap:10px;padding:4px">
                <span style="font-size:22px">📄</span>
                <div style="text-align:left">
                  <div id="contrato-nombre" style="font-size:13px;font-weight:600;color:#334155"></div>
                  <div id="contrato-tamano" style="font-size:11px;color:#94a3b8"></div>
                </div>
                <span style="margin-left:auto;color:#10b981;font-size:18px;font-weight:700">✓</span>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label>Funcion que Desempena</label>
            <textarea name="funcion" class="form-control" rows="3"
              placeholder="Describe las actividades que realizas en la empresa..."></textarea>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Tiempo que lleva con la Empresa</label>
              <input type="text" name="tiempo_empresa" class="form-control" placeholder="Ej: 2 meses">
            </div>
            <div class="form-group">
              <label>Salario</label>
              <input type="text" name="salario" class="form-control" placeholder="1160000">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Fecha de Inicio *</label>
              <input type="date" name="fecha_inicio" class="form-control" required>
            </div>
            <div class="form-group">
              <label>Fecha de Fin *</label>
              <input type="date" name="fecha_fin" class="form-control" required>
            </div>
          </div>

          <div class="form-group">
            <label>Desarrollo de la Practica</label>
            <textarea name="desarrollo" class="form-control" rows="3"
              placeholder="Describe como se esta desarrollando tu practica..."></textarea>
          </div>

          <div class="form-group">
            <label>Observacion</label>
            <textarea name="observacion" class="form-control" rows="2"
              placeholder="Observaciones adicionales..."></textarea>
          </div>
        </div>

        <!-- ===== PASO 4 ===== -->
        <div class="form-step" id="step-4">
          <h3 class="step-title">Seguridad Social</h3>

          <h4 class="subsection-title">EPS — Entidad Promotora de Salud</h4>

          <div class="form-row">
            <div class="form-group">
              <input type="text" name="eps" class="form-control" placeholder="Ej: Sura, Sanitas, Compensar...">
            </div>
            <div class="form-group">
              <label>Certificado de la EPS</label>
              <div style="border:2px dashed #cbd5e1;border-radius:10px;padding:16px;text-align:center;background:#f8fafc;cursor:pointer;position:relative">
                <input type="file" name="archivo_eps" accept=".pdf,.jpg,.jpeg,.png"
                       style="position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%"
                       onchange="mostrarArchivo(this,'eps')">
                <div id="eps-placeholder">
                  <div style="font-size:22px;margin-bottom:5px">💊</div>
                  <div style="font-size:13px;font-weight:600;color:#475569">Subir certificado EPS</div>
                  <div style="font-size:11px;color:#94a3b8;margin-top:2px">PDF, JPG o PNG — max. 5 MB</div>
                </div>
                <div id="eps-preview" style="display:none;align-items:center;gap:10px;padding:4px">
                  <span style="font-size:20px">📄</span>
                  <div style="text-align:left">
                    <div id="eps-nombre" style="font-size:13px;font-weight:600;color:#334155"></div>
                    <div id="eps-tamano" style="font-size:11px;color:#94a3b8"></div>
                  </div>
                  <span style="margin-left:auto;color:#10b981;font-size:18px;font-weight:700">✓</span>
                </div>
              </div>
            </div>
          </div>

          <h4 class="subsection-title">ARL — Administradora de Riesgos Laborales</h4>

          <div class="form-row">
            <div class="form-group">
              <input type="text" name="arl" class="form-control" placeholder="Ej: Positiva, Sura, Colmena...">
            </div>
            <div class="form-group">
              <label>Certificado de la ARL</label>
              <div style="border:2px dashed #cbd5e1;border-radius:10px;padding:16px;text-align:center;background:#f8fafc;cursor:pointer;position:relative">
                <input type="file" name="archivo_arl" accept=".pdf,.jpg,.jpeg,.png"
                       style="position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%"
                       onchange="mostrarArchivo(this,'arl')">
                <div id="arl-placeholder">
                  <div style="font-size:22px;margin-bottom:5px">🦺</div>
                  <div style="font-size:13px;font-weight:600;color:#475569">Subir certificado ARL</div>
                  <div style="font-size:11px;color:#94a3b8;margin-top:2px">PDF, JPG o PNG — max. 5 MB</div>
                </div>
                <div id="arl-preview" style="display:none;align-items:center;gap:10px;padding:4px">
                  <span style="font-size:20px">📄</span>
                  <div style="text-align:left">
                    <div id="arl-nombre" style="font-size:13px;font-weight:600;color:#334155"></div>
                    <div id="arl-tamano" style="font-size:11px;color:#94a3b8"></div>
                  </div>
                  <span style="margin-left:auto;color:#10b981;font-size:18px;font-weight:700">✓</span>
                </div>
              </div>
            </div>
          </div>

          <div class="final-note">
            Al hacer clic en <strong>Crear Cuenta</strong> aceptas que los datos
            ingresados son correctos y pueden ser verificados por tu docente y la institucion.
          </div>
        </div>

        <!-- NAVEGACION -->
        <div class="step-nav">
          <button type="button" class="btn btn-secondary" id="btn-prev" onclick="stepPrev()" style="display:none">
            &#x2190; Anterior
          </button>
          <span class="step-counter" id="step-counter">Paso 1 de 4</span>
          <button type="button" class="btn btn-primary" id="btn-next" onclick="stepNext()">
            Siguiente &#x2192;
          </button>
          <button type="submit" class="btn btn-success" id="btn-submit" style="display:none">
            &#x2713; Crear Cuenta
          </button>
        </div>

      </form>
    </div>
  </div>
</div>

<script>
var currentStep = 1;
var totalSteps  = 4;

function stepNext() {
  if (currentStep === 1) {
    var p1 = document.getElementById('pass1').value;
    var p2 = document.getElementById('pass2').value;
    if (p1 !== p2) { alert('Las contrasenas no coinciden.'); return; }
    if (p1.length < 6) { alert('La contrasena debe tener minimo 6 caracteres.'); return; }
  }
  if (currentStep < totalSteps) {
    document.getElementById('step-' + currentStep).classList.remove('active');
    document.querySelectorAll('.step')[currentStep - 1].classList.add('done');
    document.querySelectorAll('.step')[currentStep - 1].classList.remove('active');
    currentStep++;
    document.getElementById('step-' + currentStep).classList.add('active');
    document.querySelectorAll('.step')[currentStep - 1].classList.add('active');
    updateNav();
  }
}

function stepPrev() {
  if (currentStep > 1) {
    document.getElementById('step-' + currentStep).classList.remove('active');
    document.querySelectorAll('.step')[currentStep - 1].classList.remove('active');
    currentStep--;
    document.getElementById('step-' + currentStep).classList.add('active');
    document.querySelectorAll('.step')[currentStep - 1].classList.add('active');
    document.querySelectorAll('.step')[currentStep - 1].classList.remove('done');
    updateNav();
  }
}

function updateNav() {
  document.getElementById('btn-prev').style.display   = currentStep > 1 ? '' : 'none';
  document.getElementById('btn-next').style.display   = currentStep < totalSteps ? '' : 'none';
  document.getElementById('btn-submit').style.display = currentStep === totalSteps ? '' : 'none';
  document.getElementById('step-counter').textContent = 'Paso ' + currentStep + ' de ' + totalSteps;
}

function mostrarArchivo(input, tipo) {
  if (!input.files || !input.files[0]) return;
  var file = input.files[0];
  if (file.size > 5 * 1024 * 1024) {
    alert('El archivo es muy grande. Maximo 5 MB.');
    input.value = '';
    return;
  }
  var sz = file.size > 1048576
    ? (file.size / 1048576).toFixed(1) + ' MB'
    : (file.size / 1024).toFixed(0) + ' KB';
  document.getElementById(tipo + '-placeholder').style.display = 'none';
  document.getElementById(tipo + '-preview').style.display     = 'flex';
  document.getElementById(tipo + '-nombre').textContent        = file.name;
  document.getElementById(tipo + '-tamano').textContent        = sz;
}

function filtrarProgramas(facultadId) {
  var opts = document.querySelectorAll('#sel-programa option');
  opts.forEach(function(o) {
    if (!o.value) return;
    o.style.display = o.dataset.facultad === facultadId ? '' : 'none';
  });
  document.getElementById('sel-programa').value  = '';
  document.getElementById('sel-semestre').value  = '';
}

function filtrarSemestres(programaId) {
  var opts = document.querySelectorAll('#sel-semestre option');
  opts.forEach(function(o) {
    if (!o.value) return;
    o.style.display = o.dataset.programa === programaId ? '' : 'none';
  });
  document.getElementById('sel-semestre').value = '';
}

// Pre-llenar cedula si viene de la pantalla de verificacion
window.addEventListener('DOMContentLoaded', function() {
  var params = new URLSearchParams(window.location.search);
  var cedula = params.get('cedula');
  if (cedula) {
    var inp = document.getElementById('inp-cedula');
    if (inp) inp.value = cedula;
  }
});
</script>

</body>
</html>