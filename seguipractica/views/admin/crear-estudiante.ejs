<%- include('../partials/layout-top') %>
<div class="page-header"><h2 class="page-title">Nuevo Estudiante</h2></div>
<div class="card"><div class="card-body">
  <form action="/admin/estudiantes/crear" method="POST">
    <div class="form-row">
      <div class="form-group"><label>Nombres *</label><input type="text" name="nombres" class="form-control" required></div>
      <div class="form-group"><label>Apellidos *</label><input type="text" name="apellidos" class="form-control" required></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label>Cedula *</label><input type="text" name="cedula" class="form-control" required></div>
      <div class="form-group"><label>Correo *</label><input type="email" name="email" class="form-control" required></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label>Celular</label><input type="tel" name="celular" class="form-control"></div>
      <div class="form-group"><label>Contrasena inicial *</label><input type="text" name="password" class="form-control" placeholder="Min. 6 caracteres" required></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label>Docente Asignado</label>
        <select name="docente_id" class="form-control">
          <option value="">Sin asignar</option>
          <% for (var i = 0; i < docentes.length; i++) { %>
            <option value="<%= docentes[i].id %>"><%= docentes[i].nombres %> <%= docentes[i].apellidos %></option>
          <% } %>
        </select>
      </div>
      <div class="form-group"><label>Periodo</label>
        <select name="periodo" class="form-control"><option>2025-1</option><option>2025-2</option></select>
      </div>
    </div>
    <div class="form-group"><label>Codigo Curso</label><input type="text" name="codigo_curso" class="form-control" value="PRAC-2025-1"></div>
    <div style="display:flex;gap:10px;margin-top:6px">
      <button type="submit" class="btn btn-primary">Crear Estudiante</button>
      <a href="/admin/estudiantes" class="btn btn-secondary">Cancelar</a>
    </div>
  </form>
</div></div>
<%- include('../partials/layout-bottom') %>
